# ./start.sh generates .env with random local passwords when absent.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
HF_DB_APP_PASSWORD=
# Optional: ./start.sh --seed generates a local demo password if absent.
HF_DEMO_PASSWORD=
# Host ports (all bind to loopback).
HF_MYSQL_PORT=43307
HF_BACKEND_PORT=8090
HF_FRONTEND_PORT=5180
# Optional Compose profile m4; also bound to loopback.
HF_MQ_NAMESERVER_PORT=49876
HF_MQ_BROKER_PORT=41911
HF_REDIS_PORT=46379
